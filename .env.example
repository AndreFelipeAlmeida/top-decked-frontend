VITE_DEBUG=true

# Domínio raiz do SaaS — precisa bater com ROOT_DOMAIN do backend (ver
# top-decked-backend/.env.example). Usado só pra montar a URL de redirect
# pós-login de loja (ver src/lib/rootDomain.ts); a extração de slug em si
# sempre vem do backend. Em produção, mude pra VITE_ROOT_DOMAIN=brickei.com.br
# (ou remova a variável — esse já é o default embutido no código).
#
# localtest.me (não "localhost") pra testar subdomínio localmente — ver
# comentário em top-decked-backend/.env.example.
VITE_ROOT_DOMAIN=localtest.me